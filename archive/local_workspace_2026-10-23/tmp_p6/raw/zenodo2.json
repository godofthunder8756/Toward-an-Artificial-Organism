s", "access_request": "https://zenodo.org/api/records/21351821/access/request", "access": "https://zenodo.org/api/records/21351821/access", "communities": "https://zenodo.org/api/records/21351821/communities", "communities-suggestions": "https://zenodo.org/api/records/21351821/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/21351821/request-deletion", "file_modification": "https://zenodo.org/api/records/21351821/file-modification", "quota_increase": "https://zenodo.org/api/records/21351821/quota-increase", "requests": "https://zenodo.org/api/records/21351821/requests"}, "updated": "2026-07-14T07:18:05.458425+00:00", "recid": "21351821", "revision": 5, "files": [{"id": "e1938c10-c642-44e7-b504-6c4dcb519f1e", "key": "Summer School Abstract - Aditya Ram.pdf", "size": 50290, "checksum": "md5:dcc38d3aea867300a8e15836689f2ef7", "links": {"self": "https://zenodo.org/api/records/21351821/files/Summer%20School%20Abstract%20-%20Aditya%20Ram.pdf/content"}}], "swh": null, "owners": [{"id": "1646154"}], "status": "published", "stats": {"downloads": 1, "unique_downloads": 1, "views": 17, "unique_views": 12, "version_downloads": 1, "version_unique_downloads": 1, "version_unique_views": 12, "version_views": 17}, "state": "done", "submitted": true}, {"created": "2026-04-14T06:28:02.244256+00:00", "modified": "2026-04-14T06:28:02.533125+00:00", "id": 19563966, "conceptrecid": "19563965", "doi": "10.5281/zenodo.19563966", "conceptdoi": "10.5281/zenodo.19563965", "doi_url": "https://doi.org/10.5281/zenodo.19563966", "metadata": {"title": "Deep Learning-Based Generation And Detection Of Face Morphing Attacks For Secure Biometric Authentication", "doi": "10.5281/zenodo.19563966", "publication_date": "2026-01-01", "description": "The rapid adoption of biometric authentication systems, particularly facial recognition technologies, has significantly improved identity verification in applications such as border control, digital identity management, and secure access systems. However, these systems remain vulnerable to sophisticated biometric attacks, among which face morphing attacks pose a serious security threat. In a morphing attack, facial images of two or more individuals are digitally combined to create a synthetic image that resembles multiple identities, allowing attackers to bypass biometric verification systems. Detecting such manipulated images is challenging due to variations in illumination, facial expressions, accessories, and image quality. This study proposes a robust deep learning\u2013based framework for the generation and detection of face morphing attacks in biometric systems. The proposed approach integrates an advanced feature extraction mechanism with machine learning\u2013based classification techniques to effectively distinguish between genuine and morphed facial images. To enhance detection performance, image preprocessing and enhancement techniques are incorporated to reduce noise and improve feature representation. Additionally, a diverse morph dataset containing both Morph-2 and Morph-3 images is utilized to simulate realistic morphing attack scenarios and improve model generalization across different facial characteristics. Multiple experimental evaluations are conducted using several publicly available facial image databases. The performance of the proposed model is assessed using evaluation metrics such as accuracy, precision, recall, F1-score, and detection error rates. Experimental results demonstrate that the proposed framework significantly improves morphing attack detection accuracy and provides a reliable defence mechanism for biometric authentication systems. By enhancing detection reliability and robustness, the proposed approach contributes to strengthening the security of modern facial recognition systems against identity fraud and biometric spoofing attacks.", "access_right": "open", "creators": [{"name": "Mrs. A. Daiva Krupa Nirmala", "affiliation": null}, {"name": "Karrothu Nikhitha", "affiliation": null}, {"name": "Mohammed Sultana", "affiliation": null}, {"name": "Pati Yuktha", "affiliation": null}, {"name": "Palika Pavan Sai", "affiliation": null}, {"name": "Uppalapati Rajesh", "affiliation": null}], "related_identifiers": [{"identifier": "https://www.ijset.in/deep-learning-based-generation-and-detection-of-face-morphing-attacks-for-secure-biometric-authentication/", "relation": "isIdenticalTo", "resource_type": "publication-article", "scheme": "url"}, {"identifier": "https://www.ijset.in/wp-content/uploads/IJSET_V14_issue2_358.pdf", "relation": "hasPart", "resource_type": "publication-article", "scheme": "url"}], "language": "eng", "resource_type": {"title": "Journal article", "type": "publication", "subtype": "article"}, "journal": {"issue": "2", "title": "International Journal of Science, Engineering and Technology", "volume": "14"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "19563965"}}]}}, "title": "Deep Learning-Based Generation And Detection Of Face Morphing Attacks For Secure Biometric Authentication", "links": {"self": "https://zenodo.org/api/records/19563966", "self_html": "https://zenodo.org/records/19563966", "preview_html": "https://zenodo.org/records/19563966?preview=1", "doi": "https://doi.org/10.5281/zenodo.19563966", "self_doi": "https://doi.org/10.5281/zenodo.19563966", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19563966", "reserve_doi": "https://zenodo.org/api/records/19563966/draft/pids/doi", "parent": "https://zenodo.org/api/records/19563965", "parent_html": "https://zenodo.org/records/19563965", "parent_doi": "https://doi.org/10.5281/zenodo.19563965", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19563965", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:19563966/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:19563966/sequence/default", "files": "https://zenodo.org/api/